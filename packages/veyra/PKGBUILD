pkgname=veyra
pkgver=0.1.0
pkgrel=2
pkgdesc='Veyra OS system tools written in Rust'
arch=('x86_64')
url='https://github.com/abduali-kaz/VeyraOS'
license=('custom')
options=('!debug')
depends=('pacman' 'sudo' 'util-linux' 'coreutils' 'curl' 'gnupg')
makedepends=('git' 'cargo')
source=("veyra::git+https://github.com/abduali-kaz/VeyraOS.git#commit=4dd5b8066f79145237208d89116352498a00ba9e")
sha256sums=('SKIP')

build() {
    cd "$srcdir/veyra"
    cargo build --release --locked
}

check() {
    cd "$srcdir/veyra"
    cargo fmt --check
    cargo test --locked
}

package() {
    install -Dm755 "$srcdir/veyra/target/release/veyra" \
        "$pkgdir/usr/bin/veyra"
}
